# ===== አስፈላጊ (Render → Environment) =====
DATABASE_URL=                      # Neon Postgres connection string (ቋሚ ማከማቻ)
ADMIN_PASSWORD=                    # የአድሚን የይለፍ ቃል (ረጅም እና ልዩ)
ADMIN_EMAIL=tirunehawoke12@gmail.com # የአድሚን ኢሜይል — የኢሜይል OTP ወደዚህ ይላካል (ባይሞላ ይህ ነባሪ ነው)
ADMIN_PHONE=0946705941             # የአድሚን ስልክ — በቦቱ «ስልኬን አጋራ» ሲያደርግ Telegram ይረጋገጣል (ባይሞላ ይህ ነባሪ ነው)
TOKEN_SECRET=                      # 40+ የዘፈቀደ ፊደል/ቁጥር (ካልተሞላ በየዲፕሎይ ሁሉም ይወጣል)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=             # ያለ @
TELEGRAM_WEBHOOK_SECRET=           # A-Z a-z 0-9 _ - ብቻ
PUBLIC_BASE_URL=https://www.ethiodigitalmarket.pro.et
SITE_URL=https://www.ethiodigitalmarket.pro.et
NEXT_PUBLIC_SITE_URL=https://www.ethiodigitalmarket.pro.et
# ===== አማራጭ =====
ADMIN_TELEGRAM_CHAT_ID=            # Bot ላይ /myid ብለው ያገኙት ቁጥር (ለአድሚን ማሳወቂያ)
COMMISSION_PCT=5
NODE_OPTIONS=--max-old-space-size=460   # Render ነጻ (512MB) ላይ build እንዳይከሽፍ
# ===== የአድሚን ኢሜይል OTP — ከሚከተሉት አንዱን ያዘጋጁ (ነጻ እቅድ አላቸው) =====
RESEND_API_KEY=                    # resend.com — ያለ ዶሜይን ማረጋገጫ ወደ ራስዎ ኢሜይል (ADMIN_EMAIL) መላክ ይችላል
# BREVO_API_KEY=                   # brevo.com — MAIL_FROM የተረጋገጠ ላኪ መሆን አለበት
# SMTP_HOST=smtp.gmail.com         # Gmail SMTP፦ SMTP_PORT=465፣ SMTP_USER=<gmail>፣ SMTP_PASS=<App Password>
MAIL_FROM=Etio Digital Market <onboarding@resend.dev>

# --- የምስል ማከማቻ (አማራጭ፤ ከ Postgres ውጭ — Cloudflare R2 / S3 / Backblaze B2) ---
# ካልተሞላ ምስሎች በ Postgres ይቀመጣሉ። ከሞሉ በኋላ አድሚን → ማርኬት → «🖼️ የምስል ማከማቻ» → «አዛውር» ይጫኑ።
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=etio-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# ለህዝብ የሚነበብ የባልዲ አድራሻ (R2 → Settings → Public access → r2.dev ወይም የራስዎ ዶሜይን) — ምስሎች በቀጥታ ከ CDN ይጫናሉ
S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
