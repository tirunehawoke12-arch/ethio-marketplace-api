# Add the NEW token generated by @BotFather. Never place it in index.html or share it.
TELEGRAM_BOT_TOKEN=PASTE_NEW_BOT_TOKEN_HERE
TELEGRAM_BOT_USERNAME=EtioMekelMarketBot
# Public domain with HTTPS enabled in Plesk
PUBLIC_BASE_URL=https://ethiodigitalmarket.pro.et
# Use a random 32+ character value. Keep it secret.
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Plesk provides PORT automatically; local development can use 3000
PORT=3000
# የአድሚን የይለፍ ቃል (አስገዳጅ፤ ረጅም እና ልዩ ያድርጉት። በ index.html ውስጥ አይቀመጥም)
ADMIN_PASSWORD=
# የክፍለ-ጊዜ ቁልፍ መፈረሚያ (አማራጭ፤ ካልተሞላ በራሱ ይፈጠራል)
TOKEN_SECRET=
# ቋሚ ማከማቻ (Render ነጻ ዕቅድ ላይ ግዴታ)፦ ከ Neon.tech የሚገኝ Postgres connection string
DATABASE_URL=
